{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codeai-team8/evaluation/event_log/v0.2",
  "title": "Evaluation event log row (one row per tool call, draft v0.2)",
  "description": "Every evaluation item (E01-E16) reads from this log. v0.2: added contract_version, rubric_id, needs_review; stages are stored in a map keyed by sub-skill so new lessons need no schema change. The flat stage_* columns of v0.1 are still accepted for Concept 3 until v1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "run_id",
    "student_id",
    "lesson_id",
    "task_id",
    "tool",
    "input_hash",
    "model_id",
    "latency_ms",
    "filter_result",
    "fallback_triggered"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "contract_version": {
      "type": "string",
      "description": "Version of the tool contract that produced the row, e.g. 0.2. Recommended in v0.2, required from v0.3."
    },
    "run_id": {
      "type": "string",
      "description": "Groups rows from one harness run or one class session."
    },
    "student_id": {
      "type": "string",
      "pattern": "^(SIM|ADV|STU)-"
    },
    "lesson_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "rubric_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "tool": {
      "enum": [
        "validate_submission",
        "route_next"
      ]
    },
    "input_hash": {
      "type": "string",
      "description": "sha256 of the canonical input JSON; used for caching and repeat-scoring (E02)."
    },
    "output": {
      "type": "object"
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "null"
        ]
      },
      "description": "Sub-skill -> stage after this call."
    },
    "stage_prompting": {
      "type": [
        "integer",
        "null"
      ],
      "deprecated": true
    },
    "stage_evaluation": {
      "type": [
        "integer",
        "null"
      ],
      "deprecated": true
    },
    "stage_prompt_revision": {
      "type": [
        "integer",
        "null"
      ],
      "deprecated": true
    },
    "needs_review": {
      "type": "boolean"
    },
    "model_id": {
      "type": "string"
    },
    "temperature": {
      "type": "number"
    },
    "tokens_in": {
      "type": "integer"
    },
    "tokens_out": {
      "type": "integer"
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "latency_ms": {
      "type": "integer"
    },
    "filter_result": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_triggered": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "sim": {
      "type": "object",
      "description": "Synthetic data only: simulated ground truth. Never present in real logs."
    }
  }
}
